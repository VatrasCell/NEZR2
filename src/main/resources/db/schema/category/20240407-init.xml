<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20240207-init" author="">
        <createTable tableName="category">
            <column name="category_id" type="bigint" autoIncrement="true"/>
            <column name="name" type="varchar(255)"/>
        </createTable>

        <addNotNullConstraint tableName="category" columnName="category_id"/>
        <addNotNullConstraint tableName="category" columnName="name"/>

        <addPrimaryKey tableName="category" columnNames="category_id"/>

        <addUniqueConstraint tableName="category" columnNames="name"/>

    </changeSet>
</databaseChangeLog>