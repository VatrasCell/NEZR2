<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">
    <changeSet id="20240207-init" author="">
        <createTable tableName="multiple_choice">
            <column name="multiple_choice_id" type="bigint" autoIncrement="true"/>
            <column name="question" type="varchar(255)"/>
            <column name="category_id" type="bigint"/>
            <column name="headline_id" type="bigint"/>
        </createTable>

        <addNotNullConstraint tableName="multiple_choice" columnName="multiple_choice_id"/>
        <addNotNullConstraint tableName="multiple_choice" columnName="question"/>
        <addNotNullConstraint tableName="multiple_choice" columnName="category_id"/>

        <addPrimaryKey tableName="multiple_choice" columnNames="multiple_choice_id"/>

        <addForeignKeyConstraint baseTableName="multiple_choice" baseColumnNames="category_id"
                                 constraintName="fk_category_multiple_choice"
                                 referencedTableName="category" referencedColumnNames="category_id"/>
        <addForeignKeyConstraint baseTableName="multiple_choice" baseColumnNames="headline_id"
                                 constraintName="fk_headline_multiple_choice"
                                 referencedTableName="headline" referencedColumnNames="headline_id"/>

    </changeSet>
</databaseChangeLog>