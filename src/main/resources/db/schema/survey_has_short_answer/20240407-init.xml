<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">
    <changeSet id="20240207-init" author="">
        <createTable tableName="survey_has_short_answer">
            <column name="s_sa_relation_id" type="bigint" autoIncrement="true"/>
            <column name="survey_id" type="bigint"/>
            <column name="short_answer_id" type="bigint"/>
        </createTable>

        <addNotNullConstraint tableName="survey_has_short_answer" columnName="s_sa_relation_id"/>
        <addNotNullConstraint tableName="survey_has_short_answer" columnName="survey_id"/>
        <addNotNullConstraint tableName="survey_has_short_answer" columnName="short_answer_id"/>

        <addPrimaryKey tableName="survey_has_short_answer" columnNames="s_sa_relation_id"/>

        <addForeignKeyConstraint baseTableName="survey_has_short_answer" baseColumnNames="survey_id"
                                 constraintName="fk_survey_survey_has_short_answer"
                                 referencedTableName="survey" referencedColumnNames="survey_id"/>
        <addForeignKeyConstraint baseTableName="survey_has_short_answer" baseColumnNames="short_answer_id"
                                 constraintName="fk_short_answer_survey_has_short_answer"
                                 referencedTableName="short_answer" referencedColumnNames="short_answer_id"/>

    </changeSet>
</databaseChangeLog>