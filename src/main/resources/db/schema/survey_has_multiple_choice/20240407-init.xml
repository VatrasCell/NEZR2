<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">
    <changeSet id="20240207-init" author="">
        <createTable tableName="survey_has_multiple_choice">
            <column name="s_mc_relation_id" type="bigint" autoIncrement="true"/>
            <column name="survey_id" type="bigint"/>
            <column name="multiple_choice_id" type="bigint"/>
        </createTable>

        <addNotNullConstraint tableName="survey_has_multiple_choice" columnName="s_mc_relation_id"/>
        <addNotNullConstraint tableName="survey_has_multiple_choice" columnName="survey_id"/>
        <addNotNullConstraint tableName="survey_has_multiple_choice" columnName="multiple_choice_id"/>

        <addPrimaryKey tableName="survey_has_multiple_choice" columnNames="s_mc_relation_id"/>

        <addForeignKeyConstraint baseTableName="survey_has_multiple_choice" baseColumnNames="survey_id"
                                 constraintName="fk_survey_survey_has_multiple_choice"
                                 referencedTableName="survey" referencedColumnNames="survey_id"/>
        <addForeignKeyConstraint baseTableName="survey_has_multiple_choice" baseColumnNames="multiple_choice_id"
                                 constraintName="fk_multiple_choice_survey_has_multiple_choice"
                                 referencedTableName="multiple_choice" referencedColumnNames="multiple_choice_id"/>

    </changeSet>
</databaseChangeLog>